; =============================================================================
; Bit2AtomPlotGRBL —— gcode-import.ts 解析测试样例
; =============================================================================
; 覆盖指令：
;   G0 (快速空程)  G1 (直线进给)  G2 (顺时针圆弧)  G3 (逆时针圆弧)
;   M3/M5 (笔落下/抬起，J-Tech / LaserGRBL 方言)  G4 (暂停，应告警跳过)
;   G17 (XY 平面)  G20/G21 (英寸/毫米)  G90/G91 (绝对/相对)  F (进给速度)
;   M6 T1 (换刀，应告警跳过)  N 行号  括号注释与分号注释
; 笔控约定（本文件同时包含两种方言，解析器应均映射为笔动作）：
;   1) Z 轴式：Z5.000 = 抬笔，Z0.000 = 落笔
;   2) M3/M5 式：M3 = 落笔（S 参数忽略），M5 = 抬笔
; 坐标口径：毫米（G20 段除外，1in = 25.4mm），绝对模式为主
; =============================================================================

; ---------- 初始化段 ----------
G21 ; 毫米模式
G90 ; 绝对定位
G17 ; XY 平面（解析器假定，遇到 G18/G19 应告警）
G54 ; 工作坐标系

; ---------- 第一组：Z 轴笔控 + 直线（G0/G1） ----------
G0 Z5.000              ; 抬笔（Z 轴式）
G0 X10 Y10             ; 空程到起点
G1 Z0.000 F1200        ; 落笔，进给 1200mm/min
G1 X40 Y10 F3000       ; 正方形底边（显式 F）
G1 X40 Y40             ; 右边（F 继承上一条）
G1 X10 Y40             ; 顶边
G1 X10 Y10             ; 左边，闭合
G1 Z5.000              ; 抬笔

; ---------- 第二组：圆弧（G2/G3，I/J 圆心偏移） ----------
G0 X20 Y10             ; 空程
G1 Z0.000 F1200        ; 落笔
G2 X30 Y0 I10 J0 F1500 ; 顺时针 90° 圆弧：圆心 (30,10)，半径 10
G3 X40 Y10 I10 J0      ; 逆时针 90° 圆弧：圆心 (40,0)，F 继承
G1 Z5.000              ; 抬笔
G0 X50 Y50
G1 Z0.000 F1200
G2 I10 J0 F1800        ; 整圆（无终点词 = 全圆），圆心 (60,50)，半径 10
G1 Z5.000              ; 抬笔

; ---------- 第三组：M3/M5 笔控方言 ----------
M3 S1000               ; 落笔（激光/主轴方言，S 参数对绘图仪无意义，忽略）
G0 X10 Y60
G1 X30 Y60 F2500
G1 X30 Y75
M5                     ; 抬笔
G0 X10 Y85
M3                     ; 落笔（无 S 参数变体）
G1 X30 Y85
G1 X20 Y92
M5                     ; 抬笔

; ---------- 第四组：相对模式（G91） ----------
G0 X45 Y15
G91                    ; 切换相对定位
M3                     ; 落笔
G1 X10 Y0              ; 相对：实际到 (55,15)
G1 X-5 Y12             ; 相对：实际到 (50,27)
G1 X-5 Y-12            ; 相对闭合：回到起点 (45,15)
M5                     ; 抬笔
G90                    ; 恢复绝对定位

; ---------- 第五组：应告警跳过的行（不静默丢弃，需计入统计） ----------
G4 P0.5                ; 暂停 0.5s（绘图仪无意义，告警跳过）
M6 T1                  ; 换刀（不支持，告警跳过）
N10 G0 X55 Y40         ; 带 N 行号的指令（N 剥离后应正常解析）
N11 G1 X65 Y40

; ---------- 第六组：英寸模式（G20，应按 1in=25.4mm 换算） ----------
G20                    ; 英寸模式
G0 X2 Y2               ; 实际 (50.8, 50.8)
M3                     ; 落笔
G1 X3 Y2 F60           ; 实际到 (76.2, 50.8)，F60in/min
G1 X3 Y3               ; 实际 (76.2, 76.2)
M5                     ; 抬笔
G21                    ; 恢复毫米模式

; ---------- 收尾 ----------
G0 Z5.000              ; 确保抬笔
M30                    ; 程序结束
